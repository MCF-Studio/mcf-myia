{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyIA",
  "version": "0.2.0",
  "identifier": "fr.mcfstudio.myia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyIA",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0d0b0a"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://cdn.discordapp.com",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Agent IA local",
    "copyright": "MCF Studio — AGPL-3.0",
    "resources": [
      "resources/sidecar/**/*"
    ],
    "publisher": "MCF Studio",
    "homepage": "https://github.com/MCF-Studio/mcf-myia",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "longDescription": "Agent IA local du quotidien : conversations, équipes d'agents, modèles Ollama, console Claude Code.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
