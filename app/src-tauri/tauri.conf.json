{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyIA",
  "version": "0.1.0",
  "identifier": "fr.mcfstudio.myia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyIA",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0d0b0a"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Agent IA local",
    "copyright": "MCF Studio — AGPL-3.0"
  }
}
