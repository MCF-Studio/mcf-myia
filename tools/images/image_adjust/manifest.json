{
  "name": "image_adjust",
  "version": "1.0.0",
  "description": "Retouches : luminosité, contraste, saturation, netteté, décalage de teinte, gamma, niveaux de gris, sépia, négatif, contraste auto, posterize, flou, pixelisation. Image ou dossier.",
  "category": "images",
  "risk": "local",
  "entrypoint": "tool.py",
  "function": "execute",
  "parameters": {
    "path": {
      "type": "string",
      "required": true,
      "description": "Image source OU dossier d'images (traite toutes les images du dossier).",
      "kind": "path"
    },
    "output": {
      "type": "string",
      "required": true,
      "description": "Fichier de sortie (si path est un fichier) ou dossier de sortie (si path est un dossier). Différent de la source ; la source n'est jamais modifiée.",
      "kind": "path",
      "access": "write"
    },
    "recursive": {
      "type": "boolean",
      "description": "Dossier : inclure les sous-dossiers (défaut false)."
    },
    "quality": {
      "type": "integer",
      "description": "Qualité 1-100 pour JPEG/WebP (défaut 90)."
    },
    "brightness": {
      "type": "number",
      "description": "Facteur (1 = inchangé)."
    },
    "contrast": {
      "type": "number",
      "description": "Facteur (1 = inchangé)."
    },
    "saturation": {
      "type": "number",
      "description": "Facteur (0 = gris, 1 = inchangé)."
    },
    "sharpness": {
      "type": "number",
      "description": "Facteur (1 = inchangé, 2 = plus net)."
    },
    "hue_shift": {
      "type": "number",
      "description": "Rotation de teinte en degrés (-180..180)."
    },
    "gamma": {
      "type": "number",
      "description": "Gamma > 0 (1 = inchangé)."
    },
    "grayscale": {
      "type": "boolean",
      "description": "Niveaux de gris."
    },
    "sepia": {
      "type": "boolean",
      "description": "Sépia."
    },
    "invert": {
      "type": "boolean",
      "description": "Négatif."
    },
    "autocontrast": {
      "type": "boolean",
      "description": "Étire les niveaux automatiquement."
    },
    "posterize": {
      "type": "integer",
      "description": "Bits par canal 1-8."
    },
    "blur": {
      "type": "number",
      "description": "Rayon du flou gaussien (px)."
    },
    "pixelate": {
      "type": "integer",
      "description": "Taille des blocs en px (>= 2) : effet pixel art."
    },
    "overwrite": {
      "type": "boolean",
      "description": "Remplacer un fichier de sortie qui existe déjà (défaut false : refus). Une image source n'est jamais remplacée."
    }
  },
  "permissions": [
    "filesystem.read",
    "filesystem.write"
  ]
}
