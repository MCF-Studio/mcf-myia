{
  "name": "cargo_check",
  "version": "1.0.0",
  "description": "Lance 'cargo check' dans un projet Rust et renvoie les diagnostics structurés (niveau, message, fichier:ligne), code de sortie et durée.",
  "category": "rust",
  "entrypoint": "tool.py",
  "function": "execute",
  "parameters": {
    "project": {
      "type": "string",
      "required": true,
      "description": "Dossier contenant Cargo.toml (workspace ou crate).",
      "kind": "path"
    },
    "timeout": {
      "type": "integer",
      "description": "Délai maximal en secondes (défaut 600)."
    }
  },
  "permissions": [
    "process.exec",
    "filesystem.read"
  ]
}
