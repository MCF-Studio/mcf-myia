{
  "name": "text_read",
  "version": "1.0.0",
  "description": "Lit un fichier texte (ou une plage de lignes) avec numéros de ligne ; sortie plafonnée.",
  "category": "files",
  "risk": "read",
  "entrypoint": "tool.py",
  "function": "execute",
  "parameters": {
    "path": {
      "type": "string",
      "description": "Fichier.",
      "required": true,
      "kind": "path"
    },
    "start": {
      "type": "integer",
      "description": "Première ligne (défaut 1).",
      "min": 1
    },
    "lines": {
      "type": "integer",
      "description": "Nombre de lignes (défaut 200).",
      "min": 1,
      "max": 2000
    }
  },
  "permissions": [
    "filesystem.read"
  ]
}
