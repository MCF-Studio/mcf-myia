{
  "name": "git_diff",
  "version": "1.0.0",
  "description": "Changements non validés (ou indexés) ; résumé par fichier + diff plafonné.",
  "category": "git",
  "risk": "read",
  "entrypoint": "tool.py",
  "function": "execute",
  "parameters": {
    "repo": {
      "type": "string",
      "description": "Dossier du dépôt.",
      "required": true,
      "kind": "path"
    },
    "staged": {
      "type": "boolean",
      "description": "Diff de l'index (défaut non)."
    },
    "path": {
      "type": "string",
      "kind": "text",
      "max_length": 400,
      "description": "Limiter à un fichier ou dossier, RELATIF au dépôt (ni chemin absolu, ni « .. », ni option)."
    },
    "max_chars": {
      "type": "integer",
      "description": "Plafond du diff (défaut 20000).",
      "min": 1,
      "max": 200000
    }
  },
  "permissions": [
    "process.exec.readonly"
  ]
}
